# Este proyecto ya trae ".env.development" (apunta a localhost:8000) y
# ".env.production" (apunta a la URL de Render) -- Vite elige el correcto
# solo según el modo (npm run dev vs npm run build). No deberías necesitar
# tocar nada normalmente.
#
# Si alguna vez necesitas una URL distinta SOLO en tu máquina (por ejemplo
# para apuntar a un backend de pruebas), copia este archivo a ".env.local"
# (ese sí está en .gitignore, nunca se sube) y Vite lo usará por encima de
# los anteriores.
VITE_API_BASE_URL=http://localhost:8000

# Opcional. Solo hace falta si el backend tiene configurada EXTERNAL_API_KEY
# (ver .env.example del backend) -- en ese caso el botón "Comprar" de este
# frontend manda este mismo valor como header X-Api-Key. Si el backend no
# la exige, puedes dejar esta línea comentada/vacía sin problema.
# VITE_API_KEY=cambia-esto-por-algo-secreto
